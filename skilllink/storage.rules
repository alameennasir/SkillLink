rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read public portfolio images and
    // write only to their own portfolio path.
    match /users/{userId}/portfolio/{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to create proposal attachments under their own user id.
    match /proposals/{userId}/{gigId}/{category}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read of gig thumbnails; require authentication for writes.
    match /gigs/{clientId}/thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Chat attachments: only the sender may write to their own sender folder.
    match /threads/{threadId}/{senderId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == senderId;
    }

    // Fallback: deny everything else.
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
